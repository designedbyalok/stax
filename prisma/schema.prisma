generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Auth.js required models ---
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  timezone      String    @default("UTC")
  inboundEmailToken String? @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  columns       Column[]
  applications  Application[]
  reminders     Reminder[]
  settings      UserSettings?
  passwordResets PasswordResetToken[]
  documents     Document[]
  emailEvents   EmailEvent[]
  calendarEvents CalendarEvent[]
  googleIntegration GoogleIntegration?
  questions     InterviewQuestion[]
  starStories   StarStory[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// --- App models ---
model UserSettings {
  id                  String  @id @default(cuid())
  userId              String  @unique
  digestEnabled       Boolean @default(true)
  digestDay           Int     @default(1)     // 0 = Sun, 1 = Mon, etc.
  digestHour          Int     @default(9)     // user-local hour
  staleDaysApplied    Int     @default(7)
  staleDaysInterview  Int     @default(5)
  skipApplyCheckpoint Boolean @default(false)
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Column {
  id               String        @id @default(cuid())
  userId           String
  name             String
  position         Int
  color            String        @default("#E2E8F0")
  isArchive        Boolean       @default(false)
  isInterviewStage Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications     Application[]

  @@index([userId, position])
}

model Application {
  id                  String    @id @default(cuid())
  userId              String
  columnId            String
  position            Int

  roleTitle           String
  companyName         String
  companyLogoUrl      String?
  logoColor           String?
  location            String?
  salaryRange         String?
  jobType             JobType?

  originalUrl         String?
  sourcePlatform      SourcePlatform?
  jobDescription      String?   @db.Text

  notes               String?   @db.Text
  resumeVersion       String?           // V1 legacy — deprecated, read-only
  coverLetterVersion  String?           // V1 legacy — deprecated, read-only
  resumeId            String?
  coverLetterId       String?

  nextAction          String?
  nextActionDate      DateTime?

  appliedAt           DateTime?
  archivedAt          DateTime?
  deletedAt           DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  column              Column    @relation(fields: [columnId], references: [id])
  resume              Document? @relation("ApplicationResume", fields: [resumeId], references: [id], onDelete: SetNull)
  coverLetter         Document? @relation("ApplicationCoverLetter", fields: [coverLetterId], references: [id], onDelete: SetNull)
  contacts            Contact[]
  activities          Activity[]
  reminders           Reminder[]
  emailEvents         EmailEvent[]
  calendarEvents      CalendarEvent[]
  checklist           InterviewChecklist?
  questions           InterviewQuestion[]

  @@index([userId, columnId, position])
  @@index([userId, deletedAt])
}

model Contact {
  id            String      @id @default(cuid())
  applicationId String
  name          String
  role          ContactRole @default(OTHER)
  email         String?
  phone         String?
  notes         String?     @db.Text
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Activity {
  id            String       @id @default(cuid())
  applicationId String
  type          ActivityType
  description   String
  metadata      Json?
  createdAt     DateTime     @default(now())
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model Reminder {
  id            String         @id @default(cuid())
  applicationId String
  userId        String
  type          ReminderType
  status        ReminderStatus @default(PENDING)
  dueAt         DateTime
  snoozedUntil  DateTime?
  createdAt     DateTime       @default(now())
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueAt])
}

enum JobType {
  FULL_TIME
  CONTRACT
  INTERNSHIP
  PART_TIME
  OTHER
}

enum SourcePlatform {
  LINKEDIN
  GREENHOUSE
  LEVER
  WORKDAY
  INDEED
  OTHER
  MANUAL
}

enum ContactRole {
  RECRUITER
  HIRING_MANAGER
  REFERRER
  OTHER
}

enum ActivityType {
  CREATED
  STATUS_CHANGED
  CONTACT_ADDED
  NOTE_ADDED
  USER_EVENT
  EMAIL_RECEIVED
}

enum ReminderType {
  AUTO_FOLLOWUP
  NEXT_ACTION_DUE
  STALE_APPLICATION
  CUSTOM
  INTERVIEW_PREP_DUE
}

enum ReminderStatus {
  PENDING
  SNOOZED
  DISMISSED
  COMPLETED
}

// --- V2: Document management ---
model Document {
  id          String        @id @default(cuid())
  userId      String
  type        DocumentType
  name        String
  filename    String
  mimeType    String
  sizeBytes   Int
  storageKey  String
  notes       String?       @db.Text
  isPrimary   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeApplications      Application[] @relation("ApplicationResume")
  coverLetterApplications Application[] @relation("ApplicationCoverLetter")

  @@index([userId, type])
}

enum DocumentType {
  RESUME
  COVER_LETTER
}

// --- V2: Email Integration ---
model EmailEvent {
  id              String        @id @default(cuid())
  userId          String
  applicationId   String?
  messageId       String        @unique // From Postmark, for deduplication
  
  senderEmail     String
  senderName      String?
  subject         String
  bodyHtml        String?       @db.Text
  bodyText        String?       @db.Text
  
  intent          EmailIntent   @default(GENERIC)
  autoAttached    Boolean       @default(false)
  matchConfidence Float?        // 0 to 1
  
  date            DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  application     Application?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId, date(sort: Desc)])
  @@index([applicationId, date(sort: Desc)])
}

enum EmailIntent {
  INTERVIEW_INVITE
  REJECTION
  OFFER
  OUTREACH
  GENERIC
}

// --- V2: Calendar Integration ---
model GoogleIntegration {
  id              String        @id @default(cuid())
  userId          String        @unique
  email           String
  encryptedToken  String        @db.Text
  iv              String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id              String        @id @default(cuid())
  userId          String
  applicationId   String
  googleEventId   String        @unique
  
  title           String
  startTime       DateTime
  endTime         DateTime
  meetLink        String?
  notes           String?       @db.Text
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  application     Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId, startTime])
  @@index([applicationId, startTime])
}

// --- V2: Interview Prep System ---
model InterviewQuestion {
  id            String       @id @default(cuid())
  userId        String
  applicationId String?
  questionText  String       @db.Text
  yourAnswer    String?      @db.Text
  tags          String[]
  isFrequent    Boolean      @default(false)
  createdAt     DateTime     @default(now())
  
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model StarStory {
  id          String   @id @default(cuid())
  userId      String
  title       String
  situation   String   @db.Text
  task        String   @db.Text
  action      String   @db.Text
  result      String   @db.Text
  tags        String[]
  workedWell  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InterviewChecklist {
  id            String      @id @default(cuid())
  applicationId String      @unique
  items         Json        // [{ text: string, checked: boolean }]
  notes         String?     @db.Text  // pre-interview prep notes
  reflection    String?     @db.Text  // post-interview reflection
  questionsToAsk Json?      // [{ text: string }]
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}
