{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js dev server",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "Inngest dev server",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["inngest-cli@latest", "dev", "-u", "http://localhost:3000/api/inngest"],
      "port": 8288
    },
    {
      "name": "Prisma Studio",
      "runtimeExecutable": "bunx",
      "runtimeArgs": ["prisma", "studio"],
      "port": 5555
    }
  ]
}
